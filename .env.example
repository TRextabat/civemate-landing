# POST JSON payloads from the waitlist form to your provider or API.
VITE_WAITLIST_ENDPOINT=https://your-waitlist-endpoint.example

# --- api/a/[id].js, api/app-home.js, api/assetlinks.js (app.civemate.com) ---
# Backend base URL for GET /activities/{id}/public-preview. Defaults to
# https://api.civemate.com if unset.
API_BASE_URL=https://api.civemate.com
# This deployment's own origin, used to build absolute og:url/og:image values.
APP_ORIGIN=https://app.civemate.com
# Store links are OPTIONAL and OFF by default (no store listing exists yet).
# Leave unset until the app is actually published — a dead store link is
# worse than the "coming soon" fallback these functions render when empty.
STORE_ANDROID_URL=
STORE_IOS_URL=
# Fallback og:image when an activity has no cover. Defaults to this
# deployment's own /og-image.png if unset.
OG_FALLBACK_IMAGE_URL=
